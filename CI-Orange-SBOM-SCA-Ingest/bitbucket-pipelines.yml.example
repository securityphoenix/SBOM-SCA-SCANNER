image: python:3.11

pipelines:
  default:
    - step:
        name: Generate SBOM and import to Phoenix
        services:
          - docker
        caches:
          - pip
        script:
          # The importer lives in the Utils repository, not in the repository being scanned, so
          # fetch it first. Previously this step ran pip and python against files it assumed were
          # already present, which only held if you happened to be scanning Utils itself.
          # $UTILS_REPO_URL and $PHOENIX_UTILS_TOKEN are repository variables; for a public
          # mirror the token can be omitted.
          - git clone --depth 1 "${UTILS_REPO_URL:-https://github.com/securityphoenix/Utils-PUB.git}" .phoenix-utils
          - export IMPORTER_DIR=".phoenix-utils/CI-Orange-SBOM-SCA-Ingest"
          - pip install -r "$IMPORTER_DIR/requirements.txt"
          # Base image (container builds): the labels reach the SBOM only from a Trivy image scan
          # (trivy image <ref>), not from trivy fs, which this pipeline runs. To send a base image from here,
          # pass --method sbom --artefact-type CONTAINER with --base-image-name and --base-image-digest instead
          # (the artefact and base image flags apply only to --method sbom; the default method is vulnerability).
          # If you also build the image, label it: docker build --label org.opencontainers.image.base.name=<ref> --label org.opencontainers.image.base.digest=<sha256:...> ...
          # See README.md, section "Base image".
          - docker run --rm -v "$BITBUCKET_CLONE_DIR:/workspace" aquasec/trivy:0.74.0 fs --scanners vuln /workspace --format cyclonedx --output /workspace/sbom.cdx.json
          - python3 "$IMPORTER_DIR/sbom_sca_single_repo_to_phoenix.py" --sbom-file sbom.cdx.json --file-path package-lock.json --from-bitbucket-env --import-type merge

definitions:
  services:
    docker:
      memory: 1024
